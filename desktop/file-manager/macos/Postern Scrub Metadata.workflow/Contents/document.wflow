				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Postern Hygiene — Finder Quick Action body.
# Finder passes the selected paths as arguments ("$@"). Resolve the shared
# core (postern-scrub.sh) that the installer placed, then scrub each file.
PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.local/bin:$HOME/bin:$PATH"
CORE=""
for c in \
  "$HOME/.local/share/postern/file-manager/postern-scrub.sh" \
  "/usr/local/share/postern/file-manager/postern-scrub.sh" \
  "/opt/homebrew/share/postern/file-manager/postern-scrub.sh"; do
  [ -x "$c" ] &amp;&amp; CORE="$c" &amp;&amp; break
done
if [ -z "$CORE" ] &amp;&amp; command -v postern-scrub.sh &gt;/dev/null 2&gt;&amp;1; then
  CORE=$(command -v postern-scrub.sh)
fi
if [ -z "$CORE" ]; then
  osascript -e 'display notification "postern-scrub.sh not found — run the installer" with title "Postern Hygiene"'
  exit 3
fi
if "$CORE" "$@" 2&gt;/tmp/postern-scrub.$$.log; then
  osascript -e 'display notification "Scrubbed copies written next to the originals" with title "Postern Hygiene"'
else
  osascript -e 'display notification "Some files could not be scrubbed — see /tmp/postern-scrub log" with title "Postern Hygiene"'
fi</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/sh</string>
