# Tolmach Subscription proxy — environment contract (operator fills this in).
#
# Copy to a real secret store; DO NOT commit a filled-in copy. In production set
# the secret rows via your platform's secret manager (e.g. `fly secrets set …`),
# never as plaintext in an image, a compose file, or the repo.
#
# The proxy runs with NONE of these set (Sovereign-only posture): /healthz is up,
# /auth/register issues reference tokens, but /v1/messages is disabled until an
# upstream key is present, and billing is disabled until Stripe is configured.
# That fail-closed default is intentional — nothing paid works by accident.

# --- REQUIRED to actually proxy Claude (Subscription tier) --------------------
# The operator's master Anthropic key. Server-side only; never reaches a browser.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Networking / hosting -----------------------------------------------------
# Listen port (default 8787). In containers this is fixed by the image's EXPOSE.
PORT=8787
# Persistent JSON store (accounts + monthly token COUNTS; never prompt text).
# In Docker/Fly this is the mounted volume path.
DATA_DIR=/data
# Exact origin of the deployed client page. Leave as the default "*" ONLY in dev;
# a key-bearing proxy with "*" lets any web origin invoke it. Set this in prod.
ALLOWED_ORIGIN=https://REPLACE_ME.example.com
# Public URL this proxy is reachable at — used as the Stripe redirect base.
PUBLIC_BASE_URL=https://REPLACE_ME.example.com

# --- Billing (Stripe). Same code for test and live; only the keys differ. -----
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_BASIC=price_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_ME

# --- Real identity (out-of-band email verification) ---------------------------
# Set to 1 to require an emailed code before a token is issued (closes the
# type-any-email-get-a-token hole). Needs MAIL_COMMAND to send the code.
REQUIRE_EMAIL_VERIFICATION=0
# Shell command that reads the message on stdin and delivers it (e.g. a sendmail
# wrapper or an API-backed script). Required when REQUIRE_EMAIL_VERIFICATION=1.
# MAIL_COMMAND=/usr/local/bin/send-verification-mail

# --- Registration abuse controls (safe defaults; tune under load) -------------
# MAX_SUBSCRIBERS=10000
# REGISTER_PER_IP_LIMIT=5
# REGISTER_GLOBAL_LIMIT=100
# REGISTER_WINDOW_MS=3600000
# Set to 1 ONLY behind an operator-controlled reverse proxy (honors X-Forwarded-For).
# TRUST_PROXY=0

# --- Dev only. NEVER set in production. ---------------------------------------
# Enables POST /billing/dev-activate (grants a paid tier with no payment). The
# proxy fail-closes and IGNORES this if production signals are present.
# DEV_MODE=1
