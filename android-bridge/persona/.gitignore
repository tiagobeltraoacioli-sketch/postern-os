# NoporIS persona app shell — build outputs & local toolchain config.
# The project now genuinely builds (`./gradlew :app:testDebugUnitTest`), so ignore the
# machine-local artifacts that build produces. The committed source + wrapper + catalog
# stay tracked; these do not.
.gradle/
build/
**/build/
local.properties
*.iml
.idea/
captures/
.kotlin/
