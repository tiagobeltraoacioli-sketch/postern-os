<!--
  Device-admin policy declaration for NoporIsDeviceAdminReceiver.

  These are the policies the DPC MAY exercise as profile owner. Declaring a policy here
  does not exercise it; the flavor policy set is applied in code (flavor/PersonaPolicySet)
  once we become profile owner, and destroy-this-world-only uses the profile-scoped
  wipe-data policy below.

  DESIGN ONLY · UNAUDITED · never provisioned on hardware.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- Destroy-this-world-only: profile-scoped wipeData — no personal-data loss. -->
        <wipe-data />
        <!-- Force a work-challenge / lock-quality on the persona's profile. -->
        <limit-password />
        <watch-login />
        <!-- Re-lock (evict keys) — used by the panic/suspend path. -->
        <force-lock />
        <!-- Disable framework features inside the profile (clean flavor: screen capture). -->
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
